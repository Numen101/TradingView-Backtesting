
 //@version=6
indicator("PER", shorttitle="PER", overlay=false, format=format.price, precision=4)

// ─────────────────────────────────────────────────────────
// Funciones
// ─────────────────────────────────────────────────────────

// Guarda los últimos cuatro EPS disponibles
saveEps(array<float> history, float eps) =>
    if not na(eps)
        array.push(history, eps)
        if array.size(history) > 4
            array.shift(history)
    history

// Calcula el EPS de los últimos cuatro resultados
calculateEpsTtm(array<float> history) =>
    array.size(history) == 4 ? array.sum(history) : na

// ─────────────────────────────────────────────────────────
// Configuración
// ─────────────────────────────────────────────────────────

string fuente = input.string(
    "Eventos actual",
    "Fuente del BPA",
    options = ["Financiero TTM", "Eventos standardized", "Eventos actual"]
)

// ─────────────────────────────────────────────────────────
// Datos financieros
// ─────────────────────────────────────────────────────────

float epsFinancial = request.financial(
    syminfo.tickerid,
    "EARNINGS_PER_SHARE_DILUTED",
    "TTM",
    gaps = barmerge.gaps_off,
    ignore_invalid_symbol = true
)

float reportedEpsEvent = request.earnings(
    syminfo.tickerid,
    earnings.actual,
    gaps = barmerge.gaps_on,
    lookahead = barmerge.lookahead_off,
    ignore_invalid_symbol = true
)

float standardizedEpsEvent = request.earnings(
    syminfo.tickerid,
    earnings.standardized,
    gaps = barmerge.gaps_on,
    lookahead = barmerge.lookahead_off,
    ignore_invalid_symbol = true
)

// ─────────────────────────────────────────────────────────
// Histórico y cálculo del EPS TTM
// ─────────────────────────────────────────────────────────

var array<float> epsActualHistory = array.new_float()
var array<float> epsStandardizedHistory = array.new_float()

float epsActual = calculateEpsTtm(saveEps(epsActualHistory, reportedEpsEvent))
float epsStandardized = calculateEpsTtm(saveEps(epsStandardizedHistory, standardizedEpsEvent))

// ─────────────────────────────────────────────────────────
// Selección y cálculo del PER
// ─────────────────────────────────────────────────────────

float epsTtm = switch fuente
    "Financiero TTM" => epsFinancial
    "Eventos standardized" => epsStandardized
    => epsActual

float per = not na(epsTtm) and epsTtm > 0 and close > 0 ? close / epsTtm : na

plot(per, "PER", color=color.blue, linewidth=2)

// ─────────────────────────────────────────────────────────
// Diagnóstico
// ─────────────────────────────────────────────────────────

plot(epsFinancial, "BPA TTM financial", display=display.data_window)
plot(epsActual, "EPS actual", display=display.data_window)
plot(epsStandardized, "EPS standardized", display=display.data_window)

plotshape(
    not na(reportedEpsEvent) and na(standardizedEpsEvent),
    title="EPS standardized ausente",
    style=shape.triangledown,
    location=location.top,
    color=color.orange,
    size=size.tiny,
    text="EPS?"
)
